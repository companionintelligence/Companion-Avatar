<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Export options for apps/mobile/scripts/ios-archive.sh. The script copies this file, sets
		teamID from APPLE_TEAM_ID, and sets the profile from APPLE_APP_STORE_PROFILE, so the
		placeholders below are never shipped as real values. The profile must be an App Store
		distribution profile for com.companionintelligence.avatar. The owner creates it; nothing here creates one.
	-->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>teamID</key>
	<string>REPLACE_WITH_APPLE_TEAM_ID</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.companionintelligence.avatar</key>
		<string>REPLACE_WITH_APP_STORE_PROFILE_NAME</string>
	</dict>
</dict>
</plist>
