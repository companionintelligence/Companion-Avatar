# Release signing for `./gradlew bundleRelease` and `./gradlew assembleRelease`.
#
# Copy this file to android/keystore.properties (gitignored) and fill it in. Or leave the file
# out and set the environment variables KEYSTORE_PATH, KEYSTORE_PASSWORD, KEY_ALIAS and
# KEY_PASSWORD instead. With neither, the release build is unsigned and Google Play will not
# accept it.
#
# storeFile is an absolute path, or a path relative to android/app.
storeFile=/absolute/path/to/upload-keystore.jks
storePassword=REPLACE_WITH_STORE_PASSWORD
keyAlias=upload
keyPassword=REPLACE_WITH_KEY_PASSWORD
