{
  "name": "@ci-avatar/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Avatar Companion desktop shell (Tauri 2) around the web app",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "npm run icons && tauri build",
    "build:debug": "npm run icons && tauri build --debug",
    "test:native": "node --test tests/*.test.mjs",
    "icons": "tauri icon \"../web/public/icons/icon-512.png\" --output src-tauri/icons"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
