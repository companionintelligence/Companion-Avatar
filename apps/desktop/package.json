{
  "name": "@ci-avatar/desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Avatar Companion desktop shell (Tauri 2) around the web app",
  "scripts": {
    "tauri": "tauri",
    "dev": "npm run notices && tauri dev",
    "build": "npm run notices && tauri build",
    "build:debug": "npm run notices && tauri build --debug",
    "test:native": "node --test tests/*.test.mjs",
    "icons": "tauri icon \"../web/public/icons/icon-512.png\" --output src-tauri/icons",
    "notices": "node ../../scripts/third-party-notices.mjs --parts web,assets,desktop --out src-tauri/notices"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
