{
  /*
   * Type-checks the stories and the Storybook config (pnpm check:stories), which no other tsconfig
   * includes. The stories sit in packages/core and use its compiler options, but Storybook is
   * installed here, so its two entry points are mapped to this app's node_modules.
   */
  "extends": "../../packages/core/tsconfig.json",
  "compilerOptions": {
    "types": [],
    // Storybook loads main.ts itself and wants relative imports there to name their extension.
    "allowImportingTsExtensions": true,
    "paths": {
      "storybook/test": ["./node_modules/storybook/dist/test/index.d.ts"],
      "@storybook/react-vite": ["./node_modules/@storybook/react-vite/dist/index.d.ts"]
    }
  },
  "include": [
    "../../packages/core/src/**/*.stories.tsx",
    "../../packages/core/src/vite-env.d.ts",
    ".storybook/*.ts",
    ".storybook/*.tsx",
    ".storybook-witness/*.ts",
    ".storybook-witness/*.tsx"
  ]
}
