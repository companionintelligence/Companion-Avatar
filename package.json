{
  "name": "ci-avatar",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @ci-avatar/web dev",
    "dev:vision": "pnpm --filter @ci-avatar/vision-pro dev",
    "dev:vanilla": "pnpm --filter @ci-avatar/vanilla-client dev",
    "ollama:serve": "sh -c 'OLLAMA_ORIGINS=\"${OLLAMA_ORIGINS:-https://avatar.ci.computer}\" ollama serve'",
    "ollama:tunnel": "sh -c 'cloudflared tunnel --url \"${OLLAMA_HOST_URL:-http://localhost:11434}\" --http-host-header=\"localhost:11434\"'",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "dev:proxy": "pnpm --filter @ci-avatar/proxy dev",
    "build:vanilla": "pnpm --filter @ci-avatar/vanilla-client build",
    "preview:vanilla": "pnpm --filter @ci-avatar/vanilla-client preview",
    "capture:vanilla": "pnpm --filter @ci-avatar/vanilla-client capture",
    "capture:vanilla-gif": "pnpm --filter @ci-avatar/vanilla-client capture-gif",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "pnpm --filter @ci-avatar/web storybook",
    "build-storybook": "pnpm --filter @ci-avatar/web build-storybook",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:agent": "playwright test tests/agent.spec.ts",
    "test:audio": "playwright test tests/audio.spec.ts",
    "test:animation": "playwright test tests/animation.spec.ts",
    "test:l5": "playwright test -c playwright.config.capture.ts tests/render-matrix.spec.ts",
    "test:visual": "playwright test -c playwright.config.capture.ts tests/avatar-visual-matrix.spec.ts",
    "test:l4": "playwright test -c playwright.config.capture.ts tests/scenarios",
    "test:capture": "playwright test -c playwright.config.capture.ts",
    "generate:avatar-media": "node scripts/generate-avatar-video.mjs",
    "generate:system-demo": "node scripts/generate-system-demo.mjs",
    "test:report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.1.0",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.58.1",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@webspatial/vite-plugin>vite": "7"
      }
    },
    "overrides": {
      "protobufjs": "^7.6.6",
      "@webspatial/builder>sharp": "^0.35.5"
    },
    "packageExtensions": {
      "@iwer/sem": {
        "dependencies": {
          "@bufbuild/protobuf": "2.11.0"
        }
      }
    }
  }
}
